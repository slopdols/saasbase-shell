# ============================================================
# Saasbase website - env template
# Copy to `.env.local` for local development. Never commit real values.
# ============================================================

# Base URL of the backend API (used when mocks are disabled)
VUE_APP_API_BASE=/api

# Force mocks off in local dev (default is ON for `npm run serve`)
# VUE_APP_ENABLE_MOCKS=false
