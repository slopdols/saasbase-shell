# ============================================================
# Pipeline control for GitHub Actions (see ../.github/workflows/ci-cd.yml)
# Deployment precedence: SKIP_ALL > FORCE_ALL > per-stage flag > change detection
# Tests run by default. Test skips are independent of deployment flags.
# ============================================================

# Force all stages to run regardless of change detection
# FORCE_ALL=true

# Skip specific stages
# SKIP_DEPLOY_BACKEND=true
# SKIP_DEPLOY_WEBSITE=true

# Force specific stages
# FORCE_DEPLOY_BACKEND=true
# FORCE_DEPLOY_WEBSITE=true

# Skip offline suites (a skipped suite is not verified)
# SKIP_TEST_INFRASTRUCTURE=true
# SKIP_TEST_BACKEND=true
# SKIP_TEST_WEBSITE_UNIT=true
# SKIP_TEST_WEBSITE_E2E=true
# SKIP_TEST_WEBSITE_AUTH=true

# Skip the post-deployment live website/API job
# SKIP_POST_DEPLOY_TESTS=true
