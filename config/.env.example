# ============================================================
# Saasbase - local environment template
# Copy to `config/.env` and fill in real values. NEVER commit `.env`.
# In production these are injected from AWS Secrets Manager.
# ============================================================

# Environment
SAASBASE_ENVIRONMENT=local
SAASBASE_DB_BACKEND=dynamo

# API / CORS
SAASBASE_CORS_ORIGINS=["http://localhost:8080"]
SAASBASE_API_PREFIX=/v1

# Data stores
SAASBASE_TABLE_MAIN=saasbase-main-dev
SAASBASE_TABLE_LEDGER=saasbase-ledger-dev
SAASBASE_TABLE_THROTTLE=saasbase-throttle-dev
SAASBASE_TABLE_WEBMETRICS=saasbase-webmetrics-dev
SAASBASE_REGION=us-east-2

# Auth (Cognito)
SAASBASE_COGNITO_USER_POOL_ID=
SAASBASE_COGNITO_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/
SAASBASE_COGNITO_AUDIENCE=
SAASBASE_COGNITO_JWKS_URL=

# Stripe
SAASBASE_STRIPE_SECRET_KEY=
SAASBASE_STRIPE_WEBHOOK_SECRET=
SAASBASE_STRIPE_PUBLISHABLE_KEY=

# Email (SES)
SAASBASE_EMAIL_FROM=no-reply@example.com

# Alerts
SAASBASE_ALERT_TELEGRAM_BOT_TOKEN=
SAASBASE_ALERT_TELEGRAM_CHAT_ID=

# Secrets (AWS)
SAASBASE_SECRETS_ARN=
